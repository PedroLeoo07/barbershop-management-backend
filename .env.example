# =====================================================
# CONFIGURAÇÕES DO SERVIDOR
# =====================================================

# Ambiente de execução: development, production, test
NODE_ENV=development

# Porta do servidor (padrão: 3001)
PORT=3001

# =====================================================
# BANCO DE DADOS POSTGRESQL
# =====================================================

# Host do banco de dados (local: localhost)
DB_HOST=localhost

# Porta do PostgreSQL (padrão: 5432)
DB_PORT=5432

# Usuário do banco de dados
DB_USER=postgres

# Senha do banco de dados
DB_PASSWORD=postgres

# Nome do banco de dados
DB_NAME=barbearia_db

# Pool de conexões (opcional)
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_IDLE_TIMEOUT=30000

# =====================================================
# AUTENTICAÇÃO JWT
# =====================================================

# Chave secreta para assinar tokens JWT (use uma chave muito segura)
# Gere uma chave forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_chave_secreta_muito_segura_aqui_64_caracteres_minimo

# Chave secreta para refresh tokens (diferente do JWT_SECRET)
JWT_REFRESH_SECRET=sua_chave_refresh_muito_segura_aqui_64_caracteres_minimo

# Tempo de expiração do access token
# Formatos: 15m, 1h, 1d, etc.
JWT_EXPIRES_IN=24h

# Tempo de expiração do refresh token
JWT_REFRESH_EXPIRES_IN=7d

# =====================================================
# SEGURANÇA
# =====================================================

# Número de rounds para hash bcrypt (10-14 recomendado)
BCRYPT_ROUNDS=12

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Rate Limit específico para autenticação
AUTH_RATE_LIMIT_WINDOW=15
AUTH_RATE_LIMIT_MAX=5

# Rate Limit para agendamentos
APPOINTMENT_RATE_LIMIT_WINDOW=15
APPOINTMENT_RATE_LIMIT_MAX=30

# =====================================================
# CORS (Cross-Origin Resource Sharing)
# =====================================================

# URLs permitidas para requisições CORS (separadas por vírgula)
# Para desenvolvimento local do frontend
CORS_ORIGIN=http://localhost:3000

# Para múltiplas URLs: http://localhost:3000,http://localhost:3001,https://meusite.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =====================================================
# SISTEMA DE LOGS
# =====================================================

# Nível de log: error, warn, info, debug
LOG_LEVEL=info

# Arquivo de log (deixe vazio para apenas console)
LOG_FILE=logs/app.log

# Logs coloridos no console (true/false)
LOG_COLORS=true

# =====================================================
# CACHE
# =====================================================

# TTL padrão do cache (em segundos)
CACHE_TTL=300

# TTL específicos por entidade
CACHE_USER_TTL=600
CACHE_SERVICE_TTL=1800
CACHE_APPOINTMENT_TTL=60

# Tamanho máximo do cache (número de itens)
CACHE_MAX_SIZE=1000

# =====================================================
# CONFIGURAÇÕES DE NEGÓCIO
# =====================================================

# Horário de funcionamento da barbearia
BUSINESS_START_HOUR=09
BUSINESS_END_HOUR=18

# Dias de funcionamento (0=domingo, 1=segunda, ..., 6=sábado)
# Exemplo: 1,2,3,4,5,6 (segunda a sábado)
BUSINESS_DAYS=1,2,3,4,5,6

# Intervalo entre agendamentos (em minutos)
APPOINTMENT_SLOT_INTERVAL=30

# Tempo mínimo de antecedência para agendamentos (em horas)
MIN_ADVANCE_BOOKING=1

# Tempo máximo de antecedência para agendamentos (em dias)
MAX_ADVANCE_BOOKING=30

# Permitir agendamentos no mesmo dia (true/false)
ALLOW_SAME_DAY_BOOKING=true

# =====================================================
# MONITORAMENTO E OBSERVABILIDADE
# =====================================================

# Habilitar métricas de performance
ENABLE_METRICS=true

# Endpoint de health check personalizado
HEALTH_CHECK_PATH=/health

# Timeout para operações de banco (em segundos)
DB_QUERY_TIMEOUT=30

# Habilitar logs de performance para queries lentas
ENABLE_SLOW_QUERY_LOG=true

# Threshold para queries lentas (em ms)
SLOW_QUERY_THRESHOLD=1000

# =====================================================
# DESENVOLVIMENTO E DEBUG
# =====================================================

# Habilitar modo de debug verbose
DEBUG_MODE=false

# Mostrar stack traces completos em erros
SHOW_STACK_TRACES=true

# Habilitar logs detalhados de SQL
LOG_SQL_QUERIES=false

# Seed automático do banco na inicialização (apenas desenvolvimento)
AUTO_SEED=false

# =====================================================
# INSTRUÇÕES IMPORTANTES
# =====================================================

# ⚠️  SEGURANÇA:
# - NUNCA commit este arquivo com valores reais!
# - Use chaves secretas fortes e únicas em produção
# - Mantenha as credenciais seguras
# - Use variáveis de ambiente em produção

# 📋 SETUP:
# 1. Copie este arquivo para .env
# 2. Configure o banco PostgreSQL local
# 3. Execute: cd sql && setup_database.bat (Windows) ou ./setup_database.sh (Linux/Mac)
# 4. Execute: npm install && npm run dev

# 🔑 Para gerar chaves seguras:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# 🧪 Testar conexão com banco:
# psql -h localhost -p 5432 -U postgres -d barbearia_db