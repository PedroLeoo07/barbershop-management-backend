# =====================================================
# CONFIGURAÇÃO DO AMBIENTE - BARBEARIA BACKEND
# =====================================================

# Environment
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=barbearia_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_CONNECTIONS=20

# JWT - IMPORTANTE: Use chaves seguras em produção (mínimo 32 caracteres)
JWT_SECRET=your_jwt_secret_key_here_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12

# CORS - Configure conforme necessário
CORS_ORIGIN=*

# =====================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Configure o banco PostgreSQL local
# 3. Execute: cd sql && setup_database.bat (Windows) ou ./setup_database.sh (Linux/Mac)
# 4. Execute: npm install && npm run dev
# =====================================================